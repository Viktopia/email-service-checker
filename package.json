{
  "name": "email-service-checker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Identify which email provider, security gateway, or forwarder handles a domain's mail by inspecting public MX records.",
  "scripts": {
    "datasets": "bun run scripts/refresh-datasets.ts",
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --serve",
    "verify": "bun run scripts/verify-build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts tests",
    "format": "biome format --write src scripts tests",
    "check": "biome check src scripts tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
